# AgentMail API key (from console.agentmail.to)
AGENTMAIL_API_KEY=YOUR_AGENTMAIL_API_KEY

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your Telegram Chat ID (from @userinfobot)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Inbox email address to monitor
AGENTMAIL_INBOX_ID=YOUR_INBOX_EMAIL

# Directory where AgentMail events are stored
# Default: ~/.agentmail/events
# Hermes Agent deployments: ~/.hermes/agentmail_events
AGENTMAIL_EVENTS_DIR=~/.agentmail/events

# Obsidian vault path (optional, for "save" action)
OBSIDIAN_VAULT=~/obsidian-vault
